{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sach-debate-ledger-v2",
  "title": "SACH Adversarial Review Ledger Schema v2",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "complexity_tier",
    "expert_panel"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "complexity_tier": {
      "type": "integer",
      "minimum": 0
    },
    "expert_panel": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expert"
      }
    },
    "tradeoffs_matrix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tradeoff"
      }
    },
    "pareto_selection": {
      "type": "object",
      "required": [
        "chosen_approach",
        "justification"
      ],
      "properties": {
        "chosen_approach": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "mitigated_risks": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "challenge": {
      "type": "object",
      "required": [
        "target",
        "counterexample",
        "expected",
        "observed_or_predicted",
        "evidence_ref",
        "disposition"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "counterexample": {
          "type": "string",
          "minLength": 3
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed_or_predicted": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "pending",
            "accepted_mitigated",
            "rejected_with_evidence"
          ]
        }
      }
    },
    "expert": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "challenges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/challenge"
          }
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/challenge"
          }
        }
      }
    },
    "tradeoff": {
      "type": "object",
      "required": [
        "approach"
      ],
      "properties": {
        "approach": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
